# FreeAgent OAuth app credentials (from https://dev.freeagent.com/ dashboard).
# The app needs a redirect URI registered for each flow you use, and they differ:
#   deployed connector    -> <PUBLIC_BASE_URL>/auth/callback  (OAuthProxy's own route)
#   local browser login   -> FREEAGENT_REDIRECT_URI, at the bottom of this file
# See README "1. Get FreeAgent credentials".
FREEAGENT_CLIENT_ID=
FREEAGENT_CLIENT_SECRET=

# Public HTTPS URL this server is reachable at (the Scaleway container URL).
PUBLIC_BASE_URL=https://your-container.functions.fnc.fr-par.scw.cloud

# Optional. Point at FreeAgent's sandbox instead of production; the OAuth endpoints are
# derived from this, so the two environments can never get crossed. The sandbox needs its
# own signup (https://signup.sandbox.freeagent.com/signup) and its own app registration —
# sandbox credentials do not work against production. Use it for anything that writes.
# FREEAGENT_API_BASE_URL=https://api.sandbox.freeagent.com/v2

# LOCAL DEVELOPMENT ONLY — never set these in the deployed container.
# Written by `uv run scripts/fa_auth.py`. Lets scripts/freeagent_api_caller.py reach real FreeAgent
# data without repeating the browser consent flow, and lets `fastmcp dev inspector
# --auth none` do the same. See .claude/skills/freeagent-api/SKILL.md
# FREEAGENT_DEV_TOKEN=
# FREEAGENT_REFRESH_TOKEN=

# Used by `uv run scripts/fa_auth.py` only — the deployed connector never reads this, it
# uses <PUBLIC_BASE_URL>/auth/callback. Must exactly match a redirect URI registered on
# your FreeAgent OAuth app.
# FREEAGENT_REDIRECT_URI=http://localhost:8723/callback
